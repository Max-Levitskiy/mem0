OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
APP_DB_NAME=mem0_app

# Public URL of the dashboard, used by the API for CORS. Behind a reverse
# proxy (e.g. Coolify), set this to the dashboard's public domain, not
# localhost — mismatched CORS origins will reject dashboard requests.
DASHBOARD_URL=http://localhost:3000

# Public URL of the API, baked into the dashboard's browser bundle. Behind a
# reverse proxy (e.g. Coolify), set this to the API's public domain.
NEXT_PUBLIC_API_URL=http://localhost:8888
# URL the dashboard container uses to reach the API server-side, over the
# compose network. Leave as-is unless you rename the mem0 service.
API_INTERNAL_URL=http://mem0:8000
NEXT_PUBLIC_INSTANCE_NAME=Mem0

# Host ports docker-compose publishes. Change these if they collide with
# other stacks on the same host (e.g. multiple apps behind Coolify).
MEM0_PORT=8888
DASHBOARD_PORT=3000
POSTGRES_HOST_PORT=8432
MEM0_MCP_PORT=8767

# Optional MCP server (server/mcp/), exposing the self-hosted API as MCP
# tools for clients that speak MCP but not this server's REST shape (Claude
# Desktop, Claude Code, Codex, ChatGPT via a remote connector, etc). Only
# needed if you run the mem0-mcp service.
#
# MEM0_MCP_API_KEY: an API key minted from this server's own dashboard
# (Settings > API Keys) — the key mem0-mcp uses server-side to call /memories.
# MCP_BEARER_TOKEN: a separate secret clients send as their MCP bearer token.
# Generate both with `openssl rand -base64 32`; they are not interchangeable.
# MEM0_MCP_BASE_URL: leave as-is unless you rename the mem0 service.
MEM0_MCP_BASE_URL=http://mem0:8000
MEM0_MCP_API_KEY=
MCP_BEARER_TOKEN=

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
